                "nodeVersion": "20"
            }
        }
    },
    "node22": {
        "image": "chainguard/wolfi-base:latest",
        "features": {
            "bash": {},
            "node": {
                "nodeVersion": "22"
            }
        }
    },
    "node24": {
        "image": "chainguard/wolfi-base:latest",
        "features": {
            "bash": {},
            "node": {
                "nodeVersion": "24"
            }
        }
    },
    "node25": {
        "image": "chainguard/wolfi-base:latest",
        "features": {
            "bash": {},
            "node": {
                "nodeVersion": "25"
            }
        }
    },
    "with_yarn": {
        "image": "chainguard/wolfi-base:latest",
        "features": {
            "bash": {},
            "node": {
                "installYarn": true
            }
        }
    },
    "with_pnpm": {
        "image": "chainguard/wolfi-base:latest",
        "features": {
            "bash": {},
