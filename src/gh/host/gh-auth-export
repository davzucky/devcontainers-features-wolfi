#!/bin/sh
set -e

TEMP_DIR=${TEMP:-"/tmp"}
TARGET_DIR="${TEMP_DIR}/gh"
TARGET_EXPORT="${TARGET_DIR}/auth-status.tsv"
JQ_EXPR='.hosts | to_entries[] | .key as $host | (.value | if type == "array" then .[] else . end) | (.oauth_token // .token // "") as $token | select($token != "") | [$host, $token] | @tsv'

mkdir -p "${TARGET_DIR}"
umask 077

if ! command -v gh >/dev/null 2>&1; then
    exit 0
fi

if gh auth status --active --json hosts --show-token --jq "${JQ_EXPR}" > "${TARGET_EXPORT}" 2>/dev/null; then
    if [ ! -s "${TARGET_EXPORT}" ]; then
        rm -f "${TARGET_EXPORT}"
    else
        chmod 600 "${TARGET_EXPORT}"
    fi
fi
