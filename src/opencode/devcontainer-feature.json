{
    "name": "opencode",
    "id": "opencode",
    "version": "1.3.0",
    "description": "Installs opencode CLI on Wolfi base images.",
    "documentationURL": "https://github.com/davzucky/devcontainers-features-wolfi/tree/main/src/opencode",
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "description": "Select the opencode CLI version to install."
        },
        "copyAuth": {
            "type": "boolean",
            "default": false,
            "description": "Whether to persist host opencode profile data in the container via a shared temp mount and symlink."
        }
    },
    "mounts": [
        {
            "source": "${localEnv:TEMP:/tmp}/opencode",
            "target": "/tmp/opencode-host-tmp",
            "type": "bind"
        }
    ],
    "postStartCommand": "/usr/local/share/opencode-auth-copy.sh"
}
